# ---- Database (PostgreSQL). `docker compose up -d` starts one on localhost:5432.
DATABASE_URL="postgresql://oes:oes@localhost:5432/oes?schema=public"

# ---- Auth.js (NextAuth v5)
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Email (sign-in links). Any SMTP URL.
# Leave EMAIL_SERVER empty in dev: emails are written to storage/dev-outbox/ and shown at /dev/outbox.
EMAIL_SERVER=""
EMAIL_FROM="Explainer Studio <benefits@example.com>"

# ---- Anthropic (reads the Schedule of Benefits / SBC, writes the script)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ---- Text-to-speech for Penny and Patch: "openai", "elevenlabs", or "silent"
# ("silent" renders the video with no voices, timed to the text; handy for local testing.)
TTS_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_VOICE_PENNY="coral"
OPENAI_VOICE_PATCH="echo"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_PENNY=""
ELEVENLABS_VOICE_PATCH=""
ELEVENLABS_MODEL="eleven_multilingual_v2"

# ---- File storage. S3_DRIVER=local writes to ./storage in dev; "s3" for any S3-compatible service.
S3_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- Rate limits (per user per hour)
RATE_LIMIT_AI_PER_HOUR="20"
RATE_LIMIT_TTS_PER_HOUR="10"

# ---- Video rendering (worker: `npm run worker`)
# Path to a Chrome/Chromium binary. Leave blank to let Remotion download its own headless shell.
REMOTION_BROWSER_EXECUTABLE=""
RENDER_CONCURRENCY=""   # frames rendered in parallel; blank = Remotion's default
