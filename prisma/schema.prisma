// Benefits explainer video maker.
// A broker uploads a plan's Schedule of Benefits or SBC, Claude writes a Penny & Patch
// script, the broker reviews and approves it, and a worker renders the MP4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  PPO
  HMO
  EPO
  POS
  HDHP_HSA // shown as "HDHP/HSA"
  Other
}

enum DocStatus {
  UPLOADED
  EXTRACTED
  FAILED
}

enum ExplainerStatus {
  DRAFT // generated or being edited; not approved
  APPROVED // approved by a broker; ready to render
  RENDERING // worker is making audio + MP4
  READY // MP4 available
  FAILED // render failed (see renderError)
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// ---------------------------------------------------------------- Auth.js

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------- agency

model Agency {
  id           String  @id @default(cuid())
  name         String
  contactEmail String?
  logoKey      String? // storage key of the logo shown on the video's end card
  brandPrimary String  @default("#2b59c3")

  users User[]
  plans Plan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- plans + videos

/// One benefit plan to explain. Benefit fields are filled from the document by Claude.
model Plan {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name     String
  carrier  String   @default("")
  type     PlanType @default(Other)
  planYear String   @default("")

  // Short display strings straight from the document, e.g. "$1,500 individual".
  deductible    String @default("")
  deductibleFam String @default("")
  oop           String @default("")
  oopFam        String @default("")
  coinsurance   String @default("")
  pcp           String @default("")
  specialist    String @default("")
  urgent        String @default("")
  er            String @default("")
  rx            String @default("")

  documents  BenefitDocument[]
  explainers Explainer[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, updatedAt])
}

/// The uploaded Schedule of Benefits or SBC PDF.
model BenefitDocument {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  fileKey       String
  fileName      String
  fileSize      Int
  pageCount     Int?
  extractedText String?   @db.Text
  usedVision    Boolean   @default(false) // true when the PDF had no text layer and Claude read the page images
  status        DocStatus @default(UPLOADED)
  error         String?

  explainers Explainer[]

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([planId])
}

model Explainer {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  documentId String?
  document   BenefitDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // ExplainerScript (src/lib/explainer/schema.ts): { plan, scenes[] }
  script Json
  status ExplainerStatus @default(DRAFT)

  // Number check: { issues: NumberIssue[], confirmed: string[] }. Approval is blocked
  // until every issue is fixed or confirmed by the broker.
  numberCheck Json?

  // Render outputs
  timeline    Json? // per-line audio keys + durations, built by the worker
  captionsKey String? // WebVTT
  mp4Key      String?
  durationSec Float?
  renderError String?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, createdAt])
}

// ---------------------------------------------------------------- audit, jobs, limits

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // e.g. "plan.create", "explainer.generate", "explainer.approve"
  entity     String
  entityId   String?
  agencyId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([entity, entityId])
}

/// DB-polled background jobs (rendering). See worker/.
model Job {
  id        String    @id @default(cuid())
  type      String // "explainer.render"
  payload   Json
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lockedAt  DateTime?
  lockedBy  String?
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

/// Fixed-window counters for rate-limiting the AI and TTS endpoints.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
